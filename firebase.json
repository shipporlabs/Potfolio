{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "usepotfolio",
          "appId": "1:610113642000:android:2480a53fb993dacaa2b495",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "usepotfolio",
          "appId": "1:610113642000:ios:009c7054ed503714a2b495",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "macos": {
        "default": {
          "projectId": "usepotfolio",
          "appId": "1:610113642000:ios:009c7054ed503714a2b495",
          "uploadDebugSymbols": false,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "usepotfolio",
          "configurations": {
            "android": "1:610113642000:android:2480a53fb993dacaa2b495",
            "ios": "1:610113642000:ios:009c7054ed503714a2b495",
            "macos": "1:610113642000:ios:009c7054ed503714a2b495",
            "web": "1:610113642000:web:c039e761eb7c960da2b495",
            "windows": "1:610113642000:web:bbf21438193f0e48a2b495"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "_redirects", "_headers", "**/*.apk"],
    "redirects": [
      { "source": "/app", "destination": "/app/", "type": 301 }
    ],
    "rewrites": [
      { "source": "/app/**", "destination": "/app/index.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      },
      {
        "source": "/app/@(index.html|flutter_service_worker.js|flutter_bootstrap.js)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
